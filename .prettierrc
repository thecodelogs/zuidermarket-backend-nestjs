{ 
	"singleQuote": true,
	"trailingComma": "all",
	"overrides": [
		{
		  "files": ["*.ts"],
		  "options": {
			"singleQuote": true,
			"trailingComma": "all",
			"tabWidth": 4
		  }
		},
		{
			"files": ["*.html, *.scss"],
			"options": {
			  "singleQuote": true,
			  "trailingComma": "all",
			  "tabWidth": 2
			}
		}
	]
}
