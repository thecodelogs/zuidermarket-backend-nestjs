# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4203
ENABLE_DOCS=true

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Database (MySQL / MariaDB)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD="your-database-password"
DB_DATABASE=zmakkie
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis (Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP (local: DevNullSMTP / FakeSMTP on port 25)
MAIL_FROM="ZuiderMAKKIE" <system@zuidermakkie.nl>
SMTP_HOST=localhost
SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Mollie payments (test key for local dev; use ngrok for webhooks)
MOLLIE_API_KEY=test_your_mollie_api_key

# Weather API
WEATHER_API_KEY=your_weather_api_key

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs/combined.log
# LOG_FILE_LEVEL=info
# LOG_CONSOLE_LEVEL=info

# Slack logging (optional — leave unset to disable)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_LOG_LEVEL=warn
# SLACK_CHANNEL=#alerts
