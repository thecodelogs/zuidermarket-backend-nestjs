{
  "name": "zuidermakkie-rest",
  "version": "2.3.0",
  "description": "",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@so-ric/colorspace": "1.1.4"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@mollie/api-client": "^3.5.1",
    "@nestjs/bull": "^0.3.1",
    "@nestjs/common": "^7.6.5",
    "@nestjs/core": "^7.6.5",
    "@nestjs/jwt": "^7.2.0",
    "@nestjs/passport": "^7.1.5",
    "@nestjs/platform-express": "^7.6.5",
    "@nestjs/schedule": "^0.4.3",
    "@nestjs/swagger": "^4.8.0",
    "@nestjs/throttler": "^1.1.3",
    "@nestjs/typeorm": "^7.1.5",
    "@nestjsx/crud": "^4.6.2",
    "@nestjsx/crud-typeorm": "^4.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^3.29.2",
    "cache-manager": "^3.4.4",
    "class-transformer": "0.2.3",
    "class-validator": "^0.13.1",
    "config": "^3.3.6",
    "date-fns": "^2.23.0",
    "dotenv": "^16.6.1",
    "helmet": "^4.6.0",
    "mysql2": "^2.3.3",
    "nanoid": "^2.1.11",
    "nest-winston": "^1.6.0",
    "nodemailer": "^6.6.3",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.3.0",
    "swagger-ui-express": "^4.1.6",
    "typeorm": "^0.2.37",
    "winston": "^3.3.3",
    "winston-slack-webhook-transport": "^1.2.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.1.1",
    "@nestjs/testing": "^8.0.6",
    "@types/bcryptjs": "^2.4.2",
    "@types/bull": "^3.15.4",
    "@types/config": "0.0.39",
    "@types/date-fns": "^2.6.0",
    "@types/express": "4.16.1",
    "@types/faker": "^5.5.8",
    "@types/helmet": "0.0.48",
    "@types/jest": "27.0.1",
    "@types/nanoid": "^2.1.0",
    "@types/node": "16.9.1",
    "@types/nodemailer": "^6.4.4",
    "@types/passport-jwt": "^3.0.6",
    "@types/passport-local": "^1.0.34",
    "@types/supertest": "2.0.11",
    "faker": "^5.5.3",
    "jest": "27.1.1",
    "prettier": "2.7.1",
    "supertest": "6.1.6",
    "ts-jest": "^27.0.5",
    "ts-node": "10.2.1",
    "tsc-watch": "4.5.0",
    "tsconfig-paths": "3.11.0",
    "tslint": "5.20.1",
    "typescript": "^4.4.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
